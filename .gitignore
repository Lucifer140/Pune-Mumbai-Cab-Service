# ==============================================================================
# SANGITA TRAVELS PUNE (PUNE TAXI CAB) - ROOT .GITIGNORE
# ==============================================================================

# 1. Environment & Secret Configuration
.env
.env.*
*.env
*.env.local
*.pem
!.env.example
!backend/.env.example
!frontend/.env.example

# 2. SQLite Relational Database Files & Journals
*.db
*.db.*
*.db-journal
*.db-wal
*.db-shm
*.db.bak
data/*.db
data/*.db-*
data/*.db.*
backend/data/*.db
backend/data/*.db-*
backend/data/*.db.*
!**/data/.gitkeep
!**/.gitkeep

# 3. Python Bytecode & Cache
__pycache__/
**/*/__pycache__/
*.py[cod]
*$py.class

# 4. Python Virtual Environments
.venv/
venv/
env/
ENV/

# 5. Python Build, Distribution & Packaging
dist/
**/dist/
build/
**/build/
*.egg-info/
.eggs/
*.egg

# 6. Testing, Quality & Coverage Tooling Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# 7. Node Dependencies & Logs
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 8. Frontend Production Builds
frontend/dist/
dist-ssr/

# 9. Dynamic User Uploads (Preserve directories via .gitkeep)
frontend/public/assets/uploads/*
frontend/assets/uploads/*
!**/uploads/.gitkeep

# 10. OS & Editor Generated Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
